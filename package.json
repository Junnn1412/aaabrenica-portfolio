{
  "name": "aaabrenica-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/validate-routes.mjs",
    "dev": "vite",
    "prebuild": "node scripts/validate-routes.mjs",
    "build": "vite build",
    "postbuild": "node scripts/verify-build-output.mjs",
    "preview": "vite preview",
    "check:routes": "node scripts/validate-routes.mjs",
    "check:build": "node scripts/verify-build-output.mjs",
    "lint:js": "eslint .",
    "lint:styles": "stylelint \"src/styles/**/*.scss\"",
    "lint": "npm run lint:js && npm run lint:styles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "html:validate": "html-validate \"dist/**/*.html\"",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify": "npm run check:routes && npm run lint && npm run format:check && npm run test && npm run build && npm run html:validate"
  },
  "dependencies": {
    "lucide": "^1.31.0",
    "motion": "^13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "html-validate": "^10.17.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.2.1"
  }
}
